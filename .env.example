# ==============================================================================
# ENGIVAULT Environment Variables Template
# ==============================================================================
# Copy this file to .env.local for local development.
# Fill in your own Supabase project credentials and generated admin access hash.

# --- Supabase Public Client (Browser & Server) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
# Legacy alias for publishable key:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Supabase Server-Only Secret (Never expose to client) ---
# Required for administrative operations to bypass Row-Level Security (RLS).
SUPABASE_SECRET_KEY=your-service-role-or-secret-key
# Legacy alias for secret key:
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Local Development Fallback Escape Hatch (Dev Only) ---
# Default is false (off). When Supabase is configured, all query/mutation errors throw loudly
# to prevent silent divergence. Set to true ONLY if you explicitly want to fall back to the
# local JSON store during offline testing.
ENGIVAULT_ALLOW_LOCAL_FALLBACK=false

# --- Admin Authentication (Server-side Access Code) ---
# The access code used to authenticate administrator sessions. Never expose to client.
ADMIN_ACCESS_CODE=your-admin-access-code
# Optional legacy hash fallback:
# ADMIN_ACCESS_CODE_HASH="scrypt:your-salt:your-hash"
# Optional dedicated HMAC signing secret (takes precedence over ADMIN_ACCESS_CODE if set):
# ADMIN_SESSION_SECRET=your-random-32-character-secret

# --- Application Configuration ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=ENGIVAULT

# --- FOLE CEV Email & Contact Us Forwarding (Server-Side Only) ---
# Resend API Key (get from https://resend.com/api-keys)
RESEND_API_KEY=re_your_resend_api_key
# Official Contact Recipient (defaults to folecev@gmail.com)
CONTACT_EMAIL_TO=folecev@gmail.com
# Verified Sender Address configured in Resend (e.g. "FOLE Web <onboarding@resend.dev>" for test/sandbox, or "FOLE Web <contact@yourdomain.com>" for production)
CONTACT_EMAIL_FROM="FOLE Web <onboarding@resend.dev>"

