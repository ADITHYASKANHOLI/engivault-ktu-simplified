# ==============================================================================
# ENGIVAULT Environment Variables Template
# ==============================================================================
# Copy this file to .env.local for local development.
# Fill in your own Supabase project credentials and generated admin access hash.

# --- Supabase Public Client (Browser & Server) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Supabase Server-Only Secret (Never expose to client) ---
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Admin Authentication (Scrypt Hash of Access Code) ---
# Format: scrypt:<salt_hex>:<hash_hex>
# Generate using scripts/generate-admin-hash.mjs
ADMIN_ACCESS_CODE_HASH="scrypt:your-salt:your-hash"

# --- Application Configuration ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=ENGIVAULT
