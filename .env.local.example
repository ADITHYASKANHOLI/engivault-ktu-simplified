# Supabase public client configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only Supabase secret (NEVER expose to client)
# MUST be the service_role key (JWT with role="service_role"), NOT the anon key.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Local development fallback escape hatch (default: false)
ENGIVAULT_ALLOW_LOCAL_FALLBACK=false

# Server-only administrator access code (NEVER expose to client)
ADMIN_ACCESS_CODE=your-admin-access-code
# Optional server-only admin secret hash
ADMIN_ACCESS_CODE_HASH=

# Optional application configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=ENGIVAULT

