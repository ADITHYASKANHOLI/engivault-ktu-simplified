# Supabase public client configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only Supabase secret (NEVER expose to client)
# Required for administrative operations to bypass Row-Level Security (RLS).
SUPABASE_SECRET_KEY=your-service-role-or-secret-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Local development fallback escape hatch (default: false)
ENGIVAULT_ALLOW_LOCAL_FALLBACK=false

# Server-only administrator access code (NEVER expose to client)
ADMIN_ACCESS_CODE=your-admin-access-code
# Optional server-only admin secret hash
ADMIN_ACCESS_CODE_HASH=

# Optional application configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=ENGIVAULT

# --- FOLE CEV Email & Contact Us Forwarding (Server-Side Only) ---
# Resend API Key (get from https://resend.com/api-keys)
RESEND_API_KEY=re_your_resend_api_key
# Official Contact Recipient (defaults to folecev@gmail.com)
CONTACT_EMAIL_TO=folecev@gmail.com
# Verified Sender Address configured in Resend (e.g. "FOLE Web <onboarding@resend.dev>" or "FOLE Web <contact@yourdomain.com>")
CONTACT_EMAIL_FROM="FOLE Web <onboarding@resend.dev>"

